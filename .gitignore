# Não basta esvaziar fotos/ — as cópias derivadas abaixo
# identificam as mesmas pessoas tão bem quanto o original.
# ---------------------------------------------------------------

# acervo das colações de grau
fotos/

# autorretratos enviados e capturados pela webcam
consultas/

# imagens com o rosto marcado pelo detector
diagnostico/

# 388 miniaturas + 18.762 vetores de rosto (.pkl)
cache/

# cópias do gabarito
backups/

# ---------------------------------------------------------------
# Peso morto — regenera sozinho, não faz sentido versionar.
# ---------------------------------------------------------------

# 1,8 GB e 33.642 arquivos; o README ensina a recriar
.venv/

# 37 MB baixados do opencv_zoo (links no README)
models/*.onnx

__pycache__/
*.pyc
.DS_Store

